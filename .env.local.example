# MongoDB
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/veyfy?retryWrites=true&w=majority

# JWT Secret – generiere einen langen zufälligen String (z.B. mit: openssl rand -hex 32)
JWT_SECRET=DEIN_GEHEIMER_JWT_STRING_HIER

# YouTube Data API v3 Key (von Google Cloud Console)
YOUTUBE_API_KEY=DEIN_YOUTUBE_API_KEY_HIER

# Download Worker URL (dein Railway/Render Service)
WORKER_URL=https://dein-worker.railway.app
WORKER_SECRET=GEHEIMER_TOKEN_ZWISCHEN_NEXTJS_UND_WORKER
